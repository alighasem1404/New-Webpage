{"kind":"table","sheet":"Launch Tracker","address":"A1:E33","rows":33,"cols":5,"values":[[null,null,null,null,null],["Verseluft Website Launch Checklist",null,null,null,null],[null,null,null,null,null],["MUST HAVE","","","",""],["Done","ID","Task","Estimate","Notes"],[false,"M01","Make the site responsive on mobile, tablet, and desktop.","4–8 hours","Check the main pages and common screen sizes."],[false,"M02","Temporarily hide sections that do not have content yet.","30–90 min","Keep empty or placeholder content out of the launch experience."],[false,"M03","Make text at the bottom of the page readable, including its hover state.","30–90 min","Check text/background contrast and hover styling."],[false,"M04","Fix broken buttons so they work or lead somewhere useful.","1–2 hours","This refers to broken buttons generally; Contact CTAs and the Contact page button have separate items below."],[false,"M05","Make the intended content cards clickable.","1–2 hours","Apply only to cards that are meant to open a page or item."],[false,"M06","Fix broken call-to-action buttons, including Contact CTAs.","30–90 min","Check CTA destinations and click behavior throughout the site."],[false,"M07","Let visitors minimize or close the full-screen Library PDF viewer.","2–4 hours","Preserve a clear way to return to the Library page."],[false,"M08","Fix the vertical text on the About Us page.","30–60 min",""],[false,"M09","Fix the About Us layout and move the top border to its intended position.","1–2 hours",""],[false,"M10","Fix the non-working button on the Contact page.","30–90 min","This may overlap with M04 or M06; inspect the actual button before changing code."],[false,"M11","Make current projects clickable.","1–2 hours","Link each project to its intended destination."],[false,"M12","Make each “View Book” button open the correct page for that book.","1–3 hours","If a real book page does not exist, report that dependency and propose a useful destination."],[false,"M13","Improve the position and readability of descriptions beside titles on the home page.","1–2 hours",""],[false,"M14","Make search behave as expected, or hide it until it is ready.","2–4 hours","Do not leave a visible search control that does not work."],[null,null,null,null,null],["GOOD TO HAVE","","","",""],["Done","ID","Task","Estimate","Notes"],[false,"G01","Adjust font sizes across the site.","1–3 hours","Agree on a consistent type scale while preserving readability."],[false,"G02","Make full-page background sections consistent in size and coverage.","1–3 hours",""],[false,"G03","Add hover animations to buttons.","30–90 min","Keep the effect subtle and preserve keyboard focus feedback."],[false,"G04","Make font sizes and spacing consistent inside buttons.","30–90 min",""],[false,"G05","Restyle About Us panels so they do not look like buttons.","30–60 min","Keep button styling for genuinely interactive elements."],[false,"G06","Keep Upcoming Books in a consistent order while browsing.","30–90 min","Preserve the intended order when the carousel advances."],[false,"G07","Improve the size and placement of arrows beside call-to-action buttons.","30–90 min",""],[false,"G08","Refresh the visual design of the Projects page.","2–5 hours","Keep project information and links easy to scan."],[false,"G09","Adjust the size of the numbers at the top of the Blog page.","30–60 min",""],[false,"G10","Correct the position of the “View Book” button in the Library.","30–60 min","Separate from M12, which fixes where the button leads."],[false,"G11","Put a plus sign before the statistics on the home page.","15–30 min","Example: “90+” rather than “+90,” if that matches the intended design."]]}
