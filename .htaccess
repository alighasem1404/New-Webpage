RewriteEngine On

# Send direct requests for /index.html to the canonical homepage.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\s?]|$) [NC]
RewriteRule ^index\.html$ https://verseluft.com/ [R=301,L]

# Use HTTPS and the preferred non-www hostname.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.verseluft\.com$ [NC]
RewriteRule ^ https://verseluft.com%{REQUEST_URI} [R=301,L]
